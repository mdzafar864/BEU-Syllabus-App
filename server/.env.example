# Copy to .env for local development (npm run dev). On Vercel / Render / Railway
# set the same names in the dashboard instead. NEVER commit the real .env.

# Atlas connection string: Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=beu_syllabus

# Comma-separated list of websites allowed to call this API (no trailing slash).
ALLOWED_ORIGINS=https://mdzafar864.github.io

# "Active users" = visitors seen within this many minutes. Keep it at least 3x
# the page heartbeat (heartbeatMs in js/config.js, default 20 s) so one missed
# beat does not drop a real user. Closing the page is detected instantly; this
# window is only the safety net for crashes / dead phones. Decimals work (0.5).
ACTIVE_WINDOW_MINUTES=1

# Raw click/action events are deleted after this many days (0 = keep forever).
# Totals (users, downloads) are kept separately and are NOT affected.
EVENT_TTL_DAYS=180

# On start-up, create missing collections / indexes / default documents.
# Set to false if your database user is not allowed to create collections.
AUTO_SEED=true

# Requests allowed per IP per minute (colleges often share one IP, keep it generous).
RATE_LIMIT_PER_MIN=300

# true when running behind Vercel / Render / Railway / nginx so the real client IP is used.
TRUST_PROXY=true

# Local server only
PORT=3000

# --- Razorpay donations -------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Start with TEST keys (rzp_test_...),
# switch to LIVE keys (rzp_live_...) only after a full test payment works.
# The key SECRET is shown once: store it only here / in the Vercel dashboard,
# never in js/, index.html, the README or git. If it ever leaks, regenerate it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. You choose this secret yourself; it must
# match what you enter there. Use a long random value (openssl rand -hex 32).
RAZORPAY_WEBHOOK_SECRET=

# Donation limits in whole rupees, and abuse protection per IP per minute.
DONATION_MIN_INR=1
DONATION_MAX_INR=50000
DONATION_RATE_LIMIT_PER_MIN=20
