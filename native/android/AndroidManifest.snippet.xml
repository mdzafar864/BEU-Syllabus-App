<!-- Merge into your app's AndroidManifest.xml -->

<!-- minSdk must be 23+. No GET_ACCOUNTS permission is needed for your own account type. -->

<!-- allowBackup=false: an encrypted prefs file restored onto another device can't be
     decrypted (its Keystore key doesn't travel), which would corrupt identity. -->
<application android:allowBackup="false">

    <service
        android:name="com.beu.syllabus.identity.IdentityAuthenticatorService"
        android:exported="false">
        <intent-filter>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent-filter>
        <meta-data
            android:name="android.accounts.AccountAuthenticator"
            android:resource="@xml/authenticator" />
    </service>
</application>

